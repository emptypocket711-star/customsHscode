NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI 보조 분석
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_CLARIFICATION_TIMEOUT_MS=2000
OPENAI_PRODUCT_SEARCH_TIMEOUT_MS=3000
AI_NORMALIZATION_CACHE_TTL_MS=604800000

# 운영 보호 장치
# 미설정 시 production에서만 활성화됩니다. 로컬에서 테스트하려면 true로 설정하세요.
RATE_LIMIT_ENABLED=
BACKGROUND_JOBS_ENABLED=
JOB_WORKER_SECRET=
NEXT_PUBLIC_APP_URL=

# 선택: 운영 다중 서버 캐시/rate limit 공유 저장소
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_TIMEOUT_MS=3000
LOOKUP_CACHE_DEBUG=
PUBLIC_DATA_REQUEST_TIMEOUT_MS=10000
CUSTOMS_API_PRODUCT_SEARCH_LIVE_ENABLED=false
CUSTOMS_API_PRODUCT_SEARCH_TIMEOUT_MS=2500

# 공공데이터포털/관세청 OpenAPI
PUBLIC_DATA_SERVICE_KEY=
CUSTOMS_API_SERVICE_KEY=
CUSTOMS_API_HS_CODE_URL=
CUSTOMS_API_HS_CODE_SERVICE_KEY=
CUSTOMS_API_HS_CODE_NAVIGATION_URL=
CUSTOMS_API_HS_CODE_NAVIGATION_SERVICE_KEY=
CUSTOMS_API_CUSTOMS_CONFIRMATION_URL=
CUSTOMS_API_TARIFF_RATE_URL=
CUSTOMS_API_TARIFF_RATE_SERVICE_KEY=
CUSTOMS_API_STATISTICAL_CODE_URL=
CUSTOMS_API_STATS_CODE_SERVICE_KEY=
CUSTOMS_API_EXCHANGE_RATE_URL=
CUSTOMS_API_EXCHANGE_RATE_SERVICE_KEY=
CUSTOMS_API_CARGO_PROGRESS_URL=

# 배포 기본값 권장
# - Vercel 런칭 전 AI_PROVIDER=openai, OPENAI_API_KEY, Supabase 3종 키를 등록하세요.
# - 문서 업로드/추출 worker가 준비되기 전까지 BACKGROUND_JOBS_ENABLED=false 또는 미설정으로 둡니다.
# - 사용자 조회에서 관세청 품명 API를 실시간 호출하지 않도록 CUSTOMS_API_PRODUCT_SEARCH_LIVE_ENABLED=false를 유지합니다.
